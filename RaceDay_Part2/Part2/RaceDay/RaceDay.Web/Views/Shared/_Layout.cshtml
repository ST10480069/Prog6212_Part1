@{
    var user = Context.Session.GetUser();
    var isOrganiser = user?.Role == "Organiser";
    var isParticipant = user?.Role == "Participant";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | RaceDay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark rd-navbar">
    <div class="container">
        <a class="navbar-brand rd-brand" asp-controller="Home" asp-action="Index">
            <i class="bi bi-lightning-charge-fill"></i> RACE<span>DAY</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav me-auto">
                @if (isOrganiser)
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Events">My Events</a></li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Upcoming Events</a></li>
                    @if (isParticipant)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyEnrolments">My Enrolments</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyResults">My Results</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Profile">Profile</a></li>
                    }
                }
            </ul>
            <ul class="navbar-nav align-items-lg-center gap-lg-2">
                @if (user != null)
                {
                    <li class="nav-item"><span class="navbar-text rd-user"><i class="bi bi-person-circle"></i> @user.FullName <span class="badge rd-role">@user.Role</span></span></li>
                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-light">Log out</button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a></li>
                    <li class="nav-item"><a class="btn btn-sm btn-rd" asp-controller="Account" asp-action="Register">Sign up</a></li>
                }
            </ul>
        </div>
    </div>
</nav>

<main class="container rd-main">
    <partial name="_Alerts" />
    @RenderBody()
</main>

<footer class="rd-footer">
    <div class="container">&copy; @DateTime.Now.Year RaceDay &middot; Run. Ride. Rise.</div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
