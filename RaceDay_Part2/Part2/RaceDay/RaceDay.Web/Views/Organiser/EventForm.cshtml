@model EventFormViewModel
@{
    var editing = Model.Id > 0;
    ViewData["Title"] = editing ? "Edit event" : "New event";
}

<div class="rd-form-card" style="max-width:720px">
    <h1 class="rd-h1">@(editing ? "Edit event" : "Create event")</h1>
    <p class="rd-sub">@(editing ? "Update the details below." : "Fill in the details to publish your event.")</p>

    <div class="rd-card"><div class="card-body">
        <form asp-action="@(editing ? "EditEvent" : "CreateEvent")" asp-route-id="@(editing ? Model.Id : (int?)null)"
              method="post" enctype="multipart/form-data" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="ExistingBannerUrl" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="EventDate" class="form-label"></label>
                    <input asp-for="EventDate" type="date" class="form-control" value="@Model.EventDate.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="EventDate" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location" class="form-control" />
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="DistanceKm" class="form-label"></label>
                    <input asp-for="DistanceKm" type="number" step="0.01" min="0.01" class="form-control" />
                    <span asp-validation-for="DistanceKm" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="EventType" class="form-label"></label>
                    <select asp-for="EventType" class="form-select" asp-items="@(new SelectList(new[] { "Run", "Walk", "Cycle" }))"></select>
                    <span asp-validation-for="EventType" class="text-danger"></span>
                </div>
            </div>

            @if (editing)
            {
                <div class="mb-3">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" class="form-select" asp-items="@(new SelectList(new[] { "Published", "Cancelled", "Completed" }))"></select>
                </div>
            }
            else
            {
                <input type="hidden" asp-for="Status" />
            }

            <div class="mb-4">
                <label asp-for="Banner" class="form-label"></label>
                @if (!string.IsNullOrEmpty(Model.ExistingBannerUrl))
                {
                    <div class="mb-2"><img src="@Model.ExistingBannerUrl" alt="Current banner" class="rd-banner" style="max-width:320px;border-radius:8px" /></div>
                }
                <input asp-for="Banner" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" />
                <div class="form-text">JPG, PNG or WEBP, up to 5 MB. @(editing ? "Leave empty to keep the current banner." : "")</div>
                <span asp-validation-for="Banner" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-rd">@(editing ? "Save changes" : "Create event")</button>
                <a class="btn btn-outline-secondary" asp-action="Events">Cancel</a>
            </div>
        </form>
    </div></div>
</div>
